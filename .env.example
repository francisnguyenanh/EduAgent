# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# Gemini API (or set up Vertex AI ADC instead and omit this)
GOOGLE_API_KEY=

# GCP project used for Firestore / Pub/Sub / Cloud Run / Vertex AI / Cloud Trace
GCP_PROJECT_ID=

# Path to a service-account JSON key (leave unset to use Application Default Credentials)
GOOGLE_APPLICATION_CREDENTIALS=

# Model overrides (defaults live in src/eduagent/config.py)
EDUAGENT_FLASH_MODEL=gemini-3.5-flash
EDUAGENT_PRO_MODEL=gemini-3.5-pro

# Gmail MCP (compose-only OAuth client — see PHASE 0 in TODO.md)
GMAIL_MCP_CLIENT_ID=
GMAIL_MCP_CLIENT_SECRET=
