# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# GCP project used for Firestore / Pub/Sub / Cloud Run / Vertex AI / Cloud Trace
GCP_PROJECT_ID=

# Path to the eduagent-sa service-account JSON key (created in Phase 0)
GOOGLE_APPLICATION_CREDENTIALS=secrets/eduagent-sa-key.json

# Gemini via Vertex AI (ADR-002: uses ADC/service-account, not a raw API key)
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_LOCATION=global

# Model overrides (defaults live in src/eduagent/config.py).
# ADR-002: gemini-3.5-pro does not exist in this project/region -- heavy_model
# uses a newer Flash release instead (still satisfies "Gemini 3.5+").
EDUAGENT_FLASH_MODEL=gemini-3.5-flash
EDUAGENT_HEAVY_MODEL=gemini-3.7-flash

# Gmail MCP OAuth client (see PHASE 0 in TODO.md / ADR-001 for the
# compose-only scope caveat) -- points at the downloaded client_secret file.
GMAIL_MCP_CLIENT_SECRET_PATH=secrets/client_secret_YOUR_CLIENT_ID.apps.googleusercontent.com.json

# Phase 3: teacher's inbox (Gmail draft recipient) and the audit-log Sheet
# (create once via eduagent.integrations.sheets_mcp.create_audit_spreadsheet()).
EDUAGENT_TEACHER_EMAIL=
EDUAGENT_AUDIT_SPREADSHEET_ID=
